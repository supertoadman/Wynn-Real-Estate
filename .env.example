# Copy to .env.local and fill in. Never commit real values.

# Public origin of the site, used for canonical URLs and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead delivery. When set, every consultation enquiry is POSTed as JSON to
# this URL (CRM, Zapier/Make hook, internal API). When unset, leads are only
# logged to the server console.
CRM_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <secret>" with each webhook call.
CRM_WEBHOOK_SECRET=
